{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-base",
      "description": "Target linux.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
        "OpenVDB_DIR": "~/OpenSource/openvdb-install/lib64/cmake/OpenVDB",
        "CMAKE_PREFIX_PATH": "/opt/intel/oneapi/tbb/latest;~/OpenSource/c-blosc-install;/usr/local/lib64/cmake/SDL2_image"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-base",
      "description": "Target Windows with the Visual Studio development environment.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "BUILD_WINDOWS_BASE": {
          "type": "BOOL",
          "value": true
        },
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "PKG_CONFIG_EXECUTABLE": "D:/__OpenSource/vcpkg/vcpkg.exe",
        "BOOST_ROOT": "D:/__OpenSource/boost_install",
        "TBB_ROOT": "C:/Program Files (x86)/Intel/oneAPI/tbb/latest",
        "BLOSC_ROOT": "D:/__OpenSource/c-blosc_install",
        "ZLIB_ROOT": "D:/__OpenSource/zlib131/zlib131_install_x64",
        "glm_DIR": "D:/__OpenSource/vcpkg/packages/glm_x86-windows/share/glm",
        "SDL2_DIR": "C:/Program Files (x86)/SDL2/cmake",
        "SDL2_image_DIR": "D:/__OpenSource/SDL_image_install_x64/cmake",
        "OpenVDB_DIR": "D:/__OpenSource/openvdb_install/lib/cmake/OpenVDB",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
        "VULKAN_BIN_DIR": "C:/VulkanSDK/1.3.290.0/Bin"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "description": "Target Windows (64-bit) with the Visual Studio development environment. (Debug)",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "description": "Target Windows (64-bit) with the Visual Studio development environment. (RelWithDebInfo)",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "x86-debug",
      "displayName": "x86 Debug",
      "description": "Target Windows (32-bit) with the Visual Studio development environment. (Debug)",
      "inherits": "windows-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x86-release",
      "displayName": "x86 Release",
      "description": "Target Windows (32-bit) with the Visual Studio development environment. (RelWithDebInfo)",
      "inherits": "x86-debug",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
